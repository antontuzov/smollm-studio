{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmolLLM Studio",
  "version": "0.1.0",
  "identifier": "studio.smollm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SmolLLM Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Developer",
    "shortDescription": "Run small local LLMs beautifully",
    "longDescription": "SmolLLM Studio discovers, downloads and runs small GGUF language models entirely on your own machine, with a chat UI and an OpenAI-compatible local server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
